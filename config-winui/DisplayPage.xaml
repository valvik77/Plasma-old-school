<UserControl x:Class="PlasmaOldSchool.Config.DisplayPage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="24" RowSpacing="14"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Title" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid Grid.Row="1" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Spacing="8"><TextBlock x:Name="QualityLabel"/><ComboBox SelectedIndex="{Binding RenderQualityIndex, Mode=TwoWay}"><ComboBoxItem Content="Baja"/><ComboBoxItem Content="Equilibrada"/><ComboBoxItem Content="Alta"/></ComboBox><TextBlock x:Name="FpsLabel"/><TextBlock Text="{Binding TargetFps}" Opacity="0.7"/><Slider Minimum="20" Maximum="75" StepFrequency="5" Value="{Binding TargetFps, Mode=TwoWay}"/><ToggleSwitch x:Name="PowerLabel" IsOn="{Binding PowerSaving, Mode=TwoWay}"/><ToggleSwitch x:Name="VignetteLabel" IsOn="{Binding Vignette, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><ToggleSwitch x:Name="ScanlineLabel" IsOn="{Binding Scanlines, Mode=TwoWay}"/><TextBlock x:Name="SpacingLabel"/><TextBlock Text="{Binding ScanlineSpacing}" Opacity="0.7"/><Slider Minimum="2" Maximum="8" StepFrequency="1" Value="{Binding ScanlineSpacing, Mode=TwoWay}"/><TextBlock x:Name="OpacityLabel"/><TextBlock Text="{Binding ScanlineOpacity}" Opacity="0.7"/><Slider Maximum="100" StepFrequency="1" Value="{Binding ScanlineOpacity, Mode=TwoWay}"/><ToggleSwitch x:Name="MirrorHLabel" IsOn="{Binding MirrorHorizontal, Mode=TwoWay}"/><ToggleSwitch x:Name="MirrorVLabel" IsOn="{Binding MirrorVertical, Mode=TwoWay}"/></StackPanel></Grid></Grid></UserControl>
