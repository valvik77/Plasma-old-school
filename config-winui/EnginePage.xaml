<UserControl x:Class="PlasmaOldSchool.Config.EnginePage" xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation" xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"><Grid Padding="24" RowSpacing="12"><Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions><TextBlock x:Name="Title" Style="{StaticResource SubtitleTextBlockStyle}"/><Grid Grid.Row="1" ColumnSpacing="24"><Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions><StackPanel Spacing="6"><TextBlock x:Name="DensityLabel"/><TextBlock Text="{Binding WaveDensity}" Opacity="0.7"/><Slider Minimum="0.5" Maximum="2" StepFrequency="0.01" Value="{Binding WaveDensity, Mode=TwoWay}"/><TextBlock x:Name="PulseLabel"/><TextBlock Text="{Binding RadialPulse}" Opacity="0.7"/><Slider Maximum="2" StepFrequency="0.01" Value="{Binding RadialPulse, Mode=TwoWay}"/><TextBlock x:Name="RotationLabel"/><TextBlock Text="{Binding RotationSpeed}" Opacity="0.7"/><Slider Maximum="2" StepFrequency="0.01" Value="{Binding RotationSpeed, Mode=TwoWay}"/><TextBlock x:Name="BrightnessLabel"/><TextBlock Text="{Binding Brightness}" Opacity="0.7"/><Slider Minimum="0.5" Maximum="1.6" StepFrequency="0.01" Value="{Binding Brightness, Mode=TwoWay}"/><TextBlock x:Name="ContrastLabel"/><TextBlock Text="{Binding Contrast}" Opacity="0.7"/><Slider Minimum="0.5" Maximum="2" StepFrequency="0.01" Value="{Binding Contrast, Mode=TwoWay}"/></StackPanel><StackPanel Grid.Column="1" Spacing="8"><ToggleSwitch x:Name="RandomLabel" IsOn="{Binding RandomOrigin, Mode=TwoWay}"/><ToggleSwitch x:Name="MovingLabel" IsOn="{Binding MovingOrigin, Mode=TwoWay}"/><TextBlock x:Name="OriginXLabel"/><TextBlock Text="{Binding OriginX}" Opacity="0.7"/><Slider Minimum="0.1" Maximum="0.9" StepFrequency="0.01" Value="{Binding OriginX, Mode=TwoWay}"/><TextBlock x:Name="OriginYLabel"/><TextBlock Text="{Binding OriginY}" Opacity="0.7"/><Slider Minimum="0.1" Maximum="0.9" StepFrequency="0.01" Value="{Binding OriginY, Mode=TwoWay}"/></StackPanel></Grid></Grid></UserControl>
